{
  "manifest_version": 3,
  "name": "ytapis - YouTube Metadata",
  "version": "1.0.0",
  "author": "geethudino (Ruthvik)",
  "description": "View YouTube video metadata, comments, and related videos from the context menu.",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ytapis - YouTube Metadata",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "512": "icons/icon512.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ytapis@djalokyt27",
      "strict_min_version": "109.0"
    }
  }
}
