{
  "name": "ytapis-core",
  "version": "2.0.0",
  "description": "Search YouTube and get video metadata - no API key required",
  "author": "geethudino (Ruthvik)",
  "keywords": ["youtube", "search", "scraper", "metadata", "innertube", "oembed"],
  "repository": {
    "type": "git",
    "url": "https://github.com/pgboyahpgr-commits/ytapis.git"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "node --import tsx --test src/__tests__/core.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
