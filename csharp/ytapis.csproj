<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>ytapis</PackageId>
    <RootNamespace>Ytapis</RootNamespace>
    <AssemblyName>ytapis</AssemblyName>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Authors>geethudino (Ruthvik)</Authors>
    <Company>geethudino</Company>
    <Description>Search YouTube and get video metadata &mdash; no API key required</Description>
  </PropertyGroup>

</Project>
